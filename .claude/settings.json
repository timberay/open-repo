{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}' || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".agent-hooks/security-check.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".agent-hooks/pretooluse-stale-check.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v jq >/dev/null 2>&1 || exit 0; export PATH=\"$HOME/.rbenv/shims:$HOME/.rbenv/bin:$PATH\"; jq -r '.tool_input.file_path' | { read -r f; if [[ \"$f\" == *.rb ]] && [ -x bin/rubocop ]; then bin/rubocop \"$f\" 2>&1; fi; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Linting Ruby file..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".agent-hooks/userpromptsubmit-pipeline.sh",
            "timeout": 5,
            "statusMessage": "Checking pipeline phase..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": ".agent-hooks/userpromptsubmit-remind.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".agent-hooks/sessionstart-inject-state.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
