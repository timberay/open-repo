# Open Repo — environment for the Docker Compose distribution.
# Copy to `.env` and fill in. `./install.sh` reads this file (and auto-fills
# RAILS_MASTER_KEY from config/master.key). `.env` is gitignored — never commit it.

# ─── Required ────────────────────────────────────────────────────────────────

# Decryption key for config/credentials.yml.enc. install.sh copies this from
# config/master.key automatically; set it by hand only if that file is absent.
RAILS_MASTER_KEY=

# Registry FQDN shown in every docker login/tag/push/pull command and used by
# Caddy for the TLS certificate. No scheme, no trailing slash. With TLS on 443
# omit the port (registry.example.com); non-standard port -> include it.
REGISTRY_HOST=registry.example.com

# Google account that owns auto-created repositories and is the break-glass
# admin. ORDERING TRAP: this user MUST complete a Google sign-in on the running
# site BEFORE the first `docker push`, or that push 500s. See docs/INSTALL.md.
REGISTRY_ADMIN_EMAIL=admin@example.com

# ─── TLS posture (Caddy bundle) ──────────────────────────────────────────────
# Caddy terminates TLS upstream, so the app must trust X-Forwarded-Proto and
# emit https URLs + Secure cookies. Keep BOTH true behind Caddy. Set both false
# only if you run the app on plain HTTP with no TLS proxy (not recommended).
RAILS_ASSUME_SSL=true
RAILS_FORCE_SSL=true

# ─── Optional ────────────────────────────────────────────────────────────────

# Comma-separated OAuth sign-up allowlist. Empty = any Google-verified email may
# sign in. Restrict to your org, e.g. REGISTRY_ALLOWED_EMAIL_DOMAINS=example.com
REGISTRY_ALLOWED_EMAIL_DOMAINS=

# Allow `docker pull` without a token (GET/HEAD on /v2). Default true
# (internal/trusted-network). Set false to require a PAT on pulls too.
REGISTRY_ANONYMOUS_PULL=true

# Puma worker processes per host (default 1). Raise on multi-core hosts.
# WEB_CONCURRENCY=2

# Solid Queue worker processes (default 1).
# JOB_CONCURRENCY=1

# RAILS_LOG_LEVEL=info
